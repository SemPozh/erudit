# Public Gateway port. Config Server and Eureka stay inside the private network.
GATEWAY_PORT=8089

# Content service database (internal Docker network only).
CONTENT_DB_USER=erudit_content
CONTENT_DB_PASSWORD=change-me
EVENT_DB_USER=erudit_event
EVENT_DB_PASSWORD=change-me
EVENT_CLICKHOUSE_USER=erudit_event
EVENT_CLICKHOUSE_PASSWORD=change-me
NOTIFICATION_DB_USER=erudit_notification
NOTIFICATION_DB_PASSWORD=change-me
USER_DB_USER=erudit_user
USER_DB_PASSWORD=change-me
QUIZ_DB_USER=erudit_quiz
QUIZ_DB_PASSWORD=change-me

# Legacy monolith profile. Copy this file to .env only when local overrides are needed.
APP_PORT=8080
POSTGRES_PORT=5432
CLICKHOUSE_HTTP_PORT=8123
POSTGRES_DB=erudit
POSTGRES_USER=erudit
POSTGRES_PASSWORD=change-me
CLICKHOUSE_DB=erudit
CLICKHOUSE_USER=erudit
CLICKHOUSE_PASSWORD=change-me

# Legacy application limits and local observability.
SPRING_PROFILES_ACTIVE=default
MEDIA_MAX_SIZE_BYTES=52428800
MEDIA_MAX_FILE_SIZE=50MB
NOTIFICATION_DAILY_LIMIT=10
NOTIFICATION_TRIGGER_CRON=0 0 * * * *
TRACING_SAMPLING_PROBABILITY=1.0
ZIPKIN_ENABLED=false
ZIPKIN_ENDPOINT=http://host.docker.internal:9411/api/v2/spans

PAYMENT_DB_USER=erudit_payment
PAYMENT_DB_PASSWORD=change-me

# Public key for the local mock webhook only.
PAYMENT_WEBHOOK_SECRET=local-webhook-secret
